# TheTVDB API credentials (https://thetvdb.com/dashboard/account/apikey)
# PIN is optional for v4 API — leave blank if you don't have one
TVDB_API_KEY=your_tvdb_api_key_here
TVDB_PIN=

# TMDB API key for movie metadata (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Host paths to your media (mounted inside the container at /media/tv and /media/movies)
MEDIA_HOST_PATH=/home/tony/server
MEDIA_HOST_MOVIES=/home/tony/server/movies

# Inside the container — docker-compose sets these automatically
MEDIA_ROOT=/media/tv
MEDIA_ROOT_MOVIES=/media/movies

# Database URL (SQLite by default — swap for PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./data/tvtrac.db

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
